@model IEnumerable<Examen_Parcial_Incidencias.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias";
}

<div class="container mt-4">
    <!-- TÍTULO FINAL INTEGRADO TRAS RESOLVER EL 2.º CONFLICTO -->
    <h1>Incidencias abiertas encontradas con consulta rápida en tiempo real</h1>

    <!-- Formulario Búsqueda Algolia -->
    <form method="get" asp-action="Incidencias" class="row g-2 mb-3 mt-2">
        <div class="col-auto">
            <input type="text" name="q" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Buscar por estación o descripción..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar con Algolia</button>
            <a asp-action="Incidencias" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>

    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover align-middle" id="tabla-incidencias">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Estación</th>
                    <th>Descripción</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr id="incidencia-row-@item.Id">
                            <td>@item.Id</td>
                            <td>@item.Estacion</td>
                            <td>@item.Descripcion</td>
                            <td>
                                <span class="badge @(item.Prioridad == "Alta" ? "bg-danger" : "bg-warning")">
                                    @item.Prioridad
                                </span>
                            </td>
                            <td><span class="badge bg-success">@item.Estado</span></td>
                            <td>
                                <form asp-action="Cerrar" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay incidencias abiertas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const wsUrl = "wss://pubsub.piehost.com/v1/subscribe?channel=incidencias-channel&apikey=DUMMY_KEY";
        let socket;

        function connectWebSocket() {
            socket = new WebSocket(wsUrl);

            socket.onmessage = function (event) {
                try {
                    const msg = JSON.parse(event.data);
                    if (msg.event_name === "IncidenciaActualizada" && msg.data) {
                        const incidenciaId = msg.data.id;
                        const nuevoEstado = msg.data.estado;

                        if (nuevoEstado === "Cerrada") {
                            const fila = document.getElementById("incidencia-row-" + incidenciaId);
                            if (fila) {
                                fila.remove();
                            }
                        }
                    }
                } catch (e) {
                    console.error("Error al procesar mensaje WebSocket:", e);
                }
            };

            socket.onclose = function () {
                setTimeout(connectWebSocket, 3000);
            };
        }

        connectWebSocket();
    </script>
}